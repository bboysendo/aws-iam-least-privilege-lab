terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

data "aws_caller_identity" "current" {}

# ---------------------------------------------------------------------------
# S3 bucket the whole lab is scoped around
# ---------------------------------------------------------------------------
resource "aws_s3_bucket" "app_assets" {
  bucket = var.bucket_name

  tags = {
    Project = var.project_name
  }
}

resource "aws_s3_bucket_public_access_block" "app_assets" {
  bucket                  = aws_s3_bucket.app_assets.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "app_assets" {
  bucket = aws_s3_bucket.app_assets.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_versioning" "app_assets" {
  bucket = aws_s3_bucket.app_assets.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_object" "sample_object" {
  bucket       = aws_s3_bucket.app_assets.id
  key          = "sample/hello.txt"
  content      = "This object exists so the lab has something real to read via the instance role.\n"
  content_type = "text/plain"
}

# ---------------------------------------------------------------------------
# IAM role + instance profile: scoped EC2 -> S3 read access, no access keys
# ---------------------------------------------------------------------------
data "aws_iam_policy_document" "ec2_assume_role" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ec2.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "ec2_s3_readonly" {
  name               = "${var.project_name}-ec2-s3-readonly-role"
  assume_role_policy = data.aws_iam_policy_document.ec2_assume_role.json
}

data "aws_iam_policy_document" "ec2_s3_readonly" {
  statement {
    sid       = "ListSpecificBucket"
    effect    = "Allow"
    actions   = ["s3:ListBucket"]
    resources = [aws_s3_bucket.app_assets.arn]
  }
  statement {
    sid       = "ReadObjectsInSpecificBucket"
    effect    = "Allow"
    actions   = ["s3:GetObject"]
    resources = ["${aws_s3_bucket.app_assets.arn}/*"]
  }
}

resource "aws_iam_policy" "ec2_s3_readonly" {
  name   = "${var.project_name}-ec2-s3-readonly-policy"
  policy = data.aws_iam_policy_document.ec2_s3_readonly.json
}

resource "aws_iam_role_policy_attachment" "ec2_s3_readonly" {
  role       = aws_iam_role.ec2_s3_readonly.name
  policy_arn = aws_iam_policy.ec2_s3_readonly.arn
}

# Lets us reach the instance via Session Manager instead of opening SSH (port 22).
resource "aws_iam_role_policy_attachment" "ssm_core" {
  role       = aws_iam_role.ec2_s3_readonly.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_instance_profile" "ec2_s3_readonly" {
  name = "${var.project_name}-ec2-s3-readonly-profile"
  role = aws_iam_role.ec2_s3_readonly.name
}

# ---------------------------------------------------------------------------
# IAM group + scoped policy for human developers (console/CLI users)
# ---------------------------------------------------------------------------
resource "aws_iam_group" "developers" {
  name = "${var.project_name}-developers"
}

data "aws_iam_policy_document" "developers_s3_app_bucket" {
  # Least privilege in IAM means ONLY granting an explicit Allow for exactly
  # what's needed — there's no need for an explicit Deny on everything else:
  # IAM denies by default unless a policy explicitly allows an action.
  statement {
    sid       = "ManageObjectsInAppBucket"
    effect    = "Allow"
    actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"]
    resources = [aws_s3_bucket.app_assets.arn, "${aws_s3_bucket.app_assets.arn}/*"]
  }
}

resource "aws_iam_policy" "developers_s3_app_bucket" {
  name   = "${var.project_name}-developers-s3-app-bucket-access"
  policy = data.aws_iam_policy_document.developers_s3_app_bucket.json
}

resource "aws_iam_group_policy_attachment" "developers_s3_app_bucket" {
  group      = aws_iam_group.developers.name
  policy_arn = aws_iam_policy.developers_s3_app_bucket.arn
}

# Optional demo user — off by default (see variables.tf). No console password
# and no access key are created here: if you enable it, add credentials
# yourself through the console so nothing sensitive is generated by Terraform.
resource "aws_iam_user" "demo_developer" {
  count = var.create_demo_iam_user ? 1 : 0
  name  = "${var.project_name}-demo-developer"
}

resource "aws_iam_group_membership" "developers" {
  count = var.create_demo_iam_user ? 1 : 0
  name  = "${var.project_name}-developers-membership"
  group = aws_iam_group.developers.name
  users = [aws_iam_user.demo_developer[0].name]
}

# ---------------------------------------------------------------------------
# EC2 instance that proves the role-based access pattern works
# ---------------------------------------------------------------------------
data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

resource "aws_security_group" "app_instance" {
  name        = "${var.project_name}-instance-sg"
  description = "No inbound rules: reachable only via SSM Session Manager."
  vpc_id      = data.aws_vpc.default.id

  egress {
    description = "Allow outbound HTTPS for SSM + S3 API calls."
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Project = var.project_name
  }
}

resource "aws_instance" "app" {
  ami                         = data.aws_ami.al2023.id
  instance_type               = var.instance_type
  subnet_id                   = data.aws_subnets.default.ids[0]
  vpc_security_group_ids      = [aws_security_group.app_instance.id]
  iam_instance_profile        = aws_iam_instance_profile.ec2_s3_readonly.name
  associate_public_ip_address = true

  user_data = <<-EOF
    #!/bin/bash
    mkdir -p /opt
    cat > /opt/verify-instance-access.sh <<'SCRIPT'
    ${indent(4, file("${path.module}/../scripts/verify-instance-access.sh"))}
    SCRIPT
    chmod +x /opt/verify-instance-access.sh
  EOF

  tags = {
    Name    = "${var.project_name}-app-instance"
    Project = var.project_name
  }
}
